# Per-item due sensors. One entity per car per due item, so tax, NCT, insurance,
# service and the timing belt can each go on a card or trigger an automation
# without digging into the summary attribute.
#
# These read the 'dues' attribute of the REST sensor above, so they cost no
# extra poll. A car with that item unset simply has no row in 'dues' and its
# sensor sits unavailable.
#
# NOTE: rows in 'dues' identify the car by NAME, not by id, so the car name
# below is a join key. Renaming a car in the app breaks these sensors until the
# names here are changed to match.
template:
  - sensor:
      # ---- Olivias Car ----
      - name: Olivias car service due
        unique_id: car_costs_car1_due_service
        unit_of_measurement: d
        availability: >-
          {{ (state_attr('sensor.car_costs_next_due','dues') or [])
             | selectattr('car','eq','Olivias Car')
             | selectattr('item','eq','Service') | list | count > 0 }}
        state: >-
          {% set d = (state_attr('sensor.car_costs_next_due','dues') or [])
             | selectattr('car','eq','Olivias Car')
             | selectattr('item','eq','Service') | first %}
          {{ d.days }}
        attributes:
          item: >-
            {% set d = (state_attr('sensor.car_costs_next_due','dues') or [])
               | selectattr('car','eq','Olivias Car')
               | selectattr('item','eq','Service') | first | default(none) %}
            {{ d.item if d else none }}
          date: >-
            {% set d = (state_attr('sensor.car_costs_next_due','dues') or [])
               | selectattr('car','eq','Olivias Car')
               | selectattr('item','eq','Service') | first | default(none) %}
