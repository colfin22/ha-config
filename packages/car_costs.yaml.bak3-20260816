automation:
  - id: car_costs_due_reminders
    alias: Car costs - renewal reminders (30d/7d)
    triggers:
      - trigger: time
        at: "09:00:00"
    actions:
      - repeat:
          for_each: >-
            {{ state_attr('sensor.car_costs_next_due', 'dues')
               | selectattr('days', 'in', [30, 7]) | list }}
          sequence:
            - variables:
                msg: >-
                  {{ repeat.item.car }}: {{ repeat.item.item }} due
                  {{ repeat.item.date }} ({{ repeat.item.days }} days)
            - action: notify.mobile_app_np3
              data:
                title: Car reminder
                message: "{{ msg }}"
                data:
                  notification_icon: mdi:car
            - action: notify.mobile_app_pixel_6a
              data:
                title: Car reminder
                message: "{{ msg }}"
                data:
                  notification_icon: mdi:car
