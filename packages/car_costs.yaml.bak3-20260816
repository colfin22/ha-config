        unique_id: car_costs_car2_eur100km
        value_template: "{{ (value_json.cars | selectattr('id','eq',2) | first).eur_per_100km }}"
        unit_of_measurement: "€/100km"
        availability: >-
          {% set c = value_json.cars | selectattr('id','eq',2) | first | default(none) %}
          {{ c is not none and c.eur_per_100km is not none }}
