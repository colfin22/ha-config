                  "header": {
                    "show": true,
                    "title": "Energy — Last 7 Days (kWh)",
                    "show_states": false,
                    "colorize_states": false
                  },
                  "series": [
                    {
                      "entity": "sensor.washing_machine_socket_energy",
                      "name": "Washing Machine",
                      "color": "#2196F3",
                      "type": "column",
                      "data_generator": "const s=await hass.callWS({type:'recorder/statistics_during_period',start_time:new Date(Date.now()-7*864e5).toISOString(),statistic_ids:[entity.entity_id],period:'day'});const d=(s[entity.entity_id]||[]);return d.map(x=>[x.start>1e10?x.start:x.start*1000,Math.max(0,x.change||0)]);"
                    },
                    {
                      "entity": "sensor.dishwasher_socket_energy",
                      "name": "Dishwasher",
                      "color": "#4CAF50",
                      "type": "column",
                      "data_generator": "const s=await hass.callWS({type:'recorder/statistics_during_period',start_time:new Date(Date.now()-7*864e5).toISOString(),statistic_ids:[entity.entity_id],period:'day'});const d=(s[entity.entity_id]||[]);return d.map(x=>[x.start>1e10?x.start:x.start*1000,Math.max(0,x.change||0)]);"
                    },
                    {
                      "entity": "sensor.tumble_dryer_socket_energy",
                      "name": "Tumble Dryer",
                      "color": "#FF5722",
                      "type": "column",
                      "data_generator": "const s=await hass.callWS({type:'recorder/statistics_during_period',start_time:new Date(Date.now()-7*864e5).toISOString(),statistic_ids:[entity.entity_id],period:'day'});const d=(s[entity.entity_id]||[]);return d.map(x=>[x.start>1e10?x.start:x.start*1000,Math.max(0,x.change||0)]);"
                    }
                  ]
                }
              ]
