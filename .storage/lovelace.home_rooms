            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "House Mode"
                },
                {
                  "type": "entities",
                  "entities": [
                    {
                      "entity": "input_select.house_mode",
                      "name": "Mode"
                    },
                    {
                      "entity": "input_boolean.guest_mode",
                      "name": "Guest"
                    },
                    {
                      "type": "buttons",
                      "entities": [
                        {
                          "entity": "input_boolean.storm_mode",
                          "name": "Storm",
                          "icon": "mdi:weather-lightning",
                          "show_icon": true,
                          "show_name": true
                        },
                        {
                          "entity": "input_boolean.maintenance_mode",
                          "name": "Maintenance",
                          "icon": "mdi:wrench",
                          "show_icon": true,
                          "show_name": true
                        }
                      ]
                    }
                  ],
                  "card_mod": {
                    "style": {
                      ".": "#states hui-buttons-row { pointer-events: none; }\n#states > *:nth-child(2) { --state-input_boolean-on-color: #2e7d32; --state-active-color: #2e7d32; --ha-switch-checked-background-color: #2e7d32; --ha-switch-checked-thumb-background-color: #2e7d32; --switch-checked-button-color: #2e7d32; --switch-checked-track-color: #2e7d32; }",
                      "hui-buttons-row": {
                        "$": {
                          "hui-buttons-base": {
                            "$": "ha-chip-set { width: 100%; justify-content: space-between; pointer-events: none; } ha-assist-chip { --ha-assist-chip-container-height: 36px; --md-assist-chip-label-text-size: 1.05em; pointer-events: none; cursor: default; } state-badge { width: 26px; height: 26px; line-height: 26px; --mdc-icon-size: 22px; } ha-assist-chip:first-of-type { --state-input_boolean-on-color: {% set l = states('sensor.met_eireann_warning_level')|lower %}{{ '#d32f2f' if 'red' in l else '#ff8100' }}; --state-active-color: {% set l = states('sensor.met_eireann_warning_level')|lower %}{{ '#d32f2f' if 'red' in l else '#ff8100' }}; } ha-assist-chip:last-of-type { --state-input_boolean-on-color: #d32f2f; --state-active-color: #d32f2f; }"
                          }
                        }
                      }
                    }
                  },
                  "state_color": true
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Heating"
                },
                {
                  "type": "custom:heating-boost-card"
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Weather"
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "sensor.met_eireann_warning_level",
                      "state": "Orange"
                    }
                  ],
                  "card": {
                    "type": "markdown",
                    "content": "🟠 **[Orange Weather {{ states('sensor.met_eireann_warning_kind') }} — {{ states('sensor.met_eireann_warning_headline') }}](https://www.met.ie/warnings)**  \nExpires {{ as_timestamp(states('sensor.met_eireann_warning_expiry')) | timestamp_custom('%H:%M, %d %b') }}",
                    "card_mod": {
                      "style": "ha-card {\n  background: rgba(245, 124, 0, 0.95) !important;\n  color: #fff !important;\n  --primary-text-color: #fff;\n  --secondary-text-color: #ffe0c0;\n  border: none;\n}\n"
                    },
                    "grid_options": {
                      "columns": 12,
                      "rows": "auto"
                    }
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "sensor.met_eireann_warning_level",
                      "state": "Red"
                    }
                  ],
                  "card": {
                    "type": "markdown",
                    "content": "🔴 **[Red Weather {{ states('sensor.met_eireann_warning_kind') }} — {{ states('sensor.met_eireann_warning_headline') }}](https://www.met.ie/warnings)**  \nExpires {{ as_timestamp(states('sensor.met_eireann_warning_expiry')) | timestamp_custom('%H:%M, %d %b') }}",
                    "card_mod": {
                      "style": "ha-card {\n  background: rgba(198, 40, 40, 0.95) !important;\n  color: #fff !important;\n  --primary-text-color: #fff;\n  --secondary-text-color: #ffcdd2;\n  border: none;\n}\n"
                    },
                    "grid_options": {
                      "columns": 12,
                      "rows": "auto"
                    }
                  }
                },
                {
                  "type": "custom:clock-weather-card",
                  "entity": "weather.forecast_home",
                  "weather_icon_type": "line",
                  "animated_icon": true,
                  "forecast_rows": 5,
                  "locale": "en-GB",
                  "time_format": 24
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Security"
                },
                {
                  "type": "custom:alarmo-card",
                  "entity": "alarm_control_panel.house",
                  "name": "House"
                },
                {
                  "type": "custom:alarmo-card",
                  "entity": "alarm_control_panel.shed",
                  "name": "Shed"
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "binary_sensor.front_door_contact",
                      "state": "off"
                    },
                    {
                      "condition": "state",
                      "entity": "binary_sensor.back_door_contact",
                      "state": "off"
                    },
                    {
                      "condition": "state",
                      "entity": "binary_sensor.patio_door_contact",
                      "state": "off"
                    },
                    {
                      "condition": "state",
                      "entity": "binary_sensor.sitting_room_window_contact",
                      "state": "off"
                    },
                    {
                      "condition": "state",
                      "entity": "binary_sensor.back_window_contact",
                      "state": "off"
                    },
                    {
                      "condition": "state",
                      "entity": "binary_sensor.colm_window_contact",
                      "state": "off"
                    },
                    {
                      "condition": "state",
                      "entity": "binary_sensor.cian_window_contact",
                      "state": "off"
                    },
                    {
                      "condition": "state",
                      "entity": "binary_sensor.aoife_window_contact",
                      "state": "off"
                    },
                    {
                      "condition": "state",
                      "entity": "binary_sensor.office_window_contact",
                      "state": "off"
                    }
                  ],
                  "card": {
                    "type": "markdown",
                    "content": "<ha-alert alert-type=\"success\">All doors and windows are closed</ha-alert>"
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "binary_sensor.front_door_contact",
                      "state": "on"
                    }
                  ],
                  "card": {
                    "type": "tile",
                    "entity": "binary_sensor.front_door_contact",
                    "name": "Front Door"
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "binary_sensor.back_door_contact",
                      "state": "on"
                    }
                  ],
                  "card": {
                    "type": "tile",
                    "entity": "binary_sensor.back_door_contact",
                    "name": "Back Door"
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "binary_sensor.patio_door_contact",
                      "state": "on"
                    }
                  ],
                  "card": {
                    "type": "tile",
                    "entity": "binary_sensor.patio_door_contact",
                    "name": "Patio Door"
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "binary_sensor.sitting_room_window_contact",
                      "state": "on"
                    }
                  ],
                  "card": {
                    "type": "tile",
                    "entity": "binary_sensor.sitting_room_window_contact",
                    "name": "Sitting Room Window"
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "binary_sensor.back_window_contact",
                      "state": "on"
                    }
                  ],
                  "card": {
                    "type": "tile",
                    "entity": "binary_sensor.back_window_contact",
                    "name": "Back Window"
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "binary_sensor.colm_window_contact",
                      "state": "on"
                    }
                  ],
                  "card": {
                    "type": "tile",
                    "entity": "binary_sensor.colm_window_contact",
                    "name": "Colm's Window"
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "binary_sensor.cian_window_contact",
                      "state": "on"
                    }
                  ],
                  "card": {
                    "type": "tile",
                    "entity": "binary_sensor.cian_window_contact",
                    "name": "Cian's Window"
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "binary_sensor.aoife_window_contact",
                      "state": "on"
                    }
                  ],
                  "card": {
                    "type": "tile",
                    "entity": "binary_sensor.aoife_window_contact",
                    "name": "Aoife's Window"
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "binary_sensor.office_window_contact",
                      "state": "on"
                    }
                  ],
                  "card": {
                    "type": "tile",
                    "entity": "binary_sensor.office_window_contact",
                    "name": "Office Window"
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Motion & Presence"
                },
                {
                  "type": "tile",
                  "entity": "binary_sensor.hallway_motion_sensor_occupancy",
                  "name": "Hallway",
                  "icon": "mdi:motion-sensor"
                },
                {
                  "type": "tile",
                  "entity": "binary_sensor.landing_motion_sensor_occupancy",
                  "name": "Landing",
                  "icon": "mdi:motion-sensor"
                },
                {
                  "type": "tile",
                  "entity": "binary_sensor.sitting_room_presence_occupancy",
                  "name": "Sitting Room"
                },
                {
                  "type": "tile",
                  "entity": "binary_sensor.office_presence_occupancy",
                  "name": "Office"
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Cameras"
                },
                {
                  "type": "custom:swipe-card",
                  "parameters": {
                    "autoplay": {
                      "delay": 10000,
                      "disableOnInteraction": false
                    },
                    "loop": true,
                    "pagination": {
                      "type": "bullets",
                      "clickable": true
                    }
                  },
                  "cards": [
                    {
                      "type": "picture-glance",
                      "entity": "camera.doorbell",
                      "camera_image": "camera.doorbell",
                      "title": "Doorbell",
                      "entities": []
                    },
                    {
                      "type": "picture-glance",
                      "entity": "camera.front_van",
                      "camera_image": "camera.front_van",
                      "title": "Front Van",
                      "entities": []
                    },
                    {
                      "type": "picture-glance",
                      "entity": "camera.front_car",
                      "camera_image": "camera.front_car",
                      "title": "Front Car",
                      "entities": []
                    },
                    {
                      "type": "picture-glance",
                      "entity": "camera.rear_door",
                      "camera_image": "camera.rear_door",
                      "title": "Rear Door",
                      "entities": []
                    },
                    {
                      "type": "picture-glance",
                      "entity": "camera.rear_shed",
                      "camera_image": "camera.rear_shed",
                      "title": "Rear Shed",
                      "entities": []
                    }
                  ]
                }
              ],
              "column_span": 1
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Photos",
                  "icon": "mdi:image-multiple"
                },
                {
                  "type": "picture-entity",
                  "entity": "image.immich_pics_for_display",
                  "show_state": false,
                  "show_name": false,
                  "tap_action": {
                    "action": "more-info"
                  }
                }
              ]
            }
          ],
          "badges": [
            {
              "type": "entity",
              "entity": "person.colm_finn",
              "name": "Colm",
              "show_entity_picture": true
            },
            {
              "type": "entity",
              "entity": "person.olivia_finn",
              "name": "Olivia",
              "show_entity_picture": true
            },
            {
              "type": "entity",
              "entity": "person.cian_finn",
              "name": "Cian",
              "show_entity_picture": true
            }
          ]
        },
        {
          "title": "Climate",
          "path": "climate",
          "icon": "mdi:thermometer",
          "type": "sections",
          "max_columns": 3,
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:heating-boost-card"
                },
                {
                  "type": "tile",
                  "entity": "input_boolean.heating_extended_away",
                  "name": "Away 24h+ → 12°C",
                  "icon": "mdi:home-thermometer-outline",
                  "state_color": true,
                  "features_position": "inline",
                  "features": [
                    {
                      "type": "toggle"
                    }
                  ]
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:apexcharts-card",
                  "graph_span": "24h",
                  "header": {
                    "show": true,
                    "title": "Thermostat Temperature",
                    "show_states": true,
                    "colorize_states": true
                  },
                  "series": [
                    {
                      "entity": "sensor.home_temperature",
                      "name": "Current",
                      "color": "#FF5722",
                      "stroke_width": 2,
                      "fill_raw": "last",
                      "yaxis_id": "temp",
                      "show": {
                        "legend_value": false
                      }
                    },
                    {
                      "entity": "climate.netatmo_smart_thermostat",
                      "attribute": "temperature",
                      "name": "Target",
                      "color": "#2196F3",
                      "stroke_width": 2,
                      "fill_raw": "last",
                      "yaxis_id": "temp",
                      "curve": "stepline",
                      "show": {
                        "legend_value": false
                      }
                    },
                    {
                      "entity": "climate.netatmo_smart_thermostat",
                      "attribute": "hvac_action",
                      "name": "Heating",
                      "color": "#FF9800",
                      "type": "area",
                      "curve": "stepline",
                      "stroke_width": 0,
                      "opacity": 0.12,
                      "yaxis_id": "heat",
                      "transform": "return x === 'heating' ? 1 : 0;",
                      "show": {
                        "legend_value": false,
                        "in_header": false
                      }
                    }
                  ],
                  "yaxis": [
                    {
                      "id": "temp",
                      "decimals": 1
                    },
                    {
                      "id": "heat",
                      "show": false,
                      "min": 0,
                      "max": 1
                    }
                  ]
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Temperature & Humidity"
                },
                {
                  "type": "tile",
                  "entity": "sensor.attic_temperature_temperature",
                  "name": "Attic"
                },
                {
                  "type": "tile",
                  "entity": "sensor.attic_temperature_humidity",
                  "name": "Attic Humidity"
                },
                {
                  "type": "tile",
                  "entity": "sensor.landing_motion_sensor_temperature",
                  "name": "Landing"
                },
                {
                  "type": "tile",
                  "entity": "sensor.hallway_motion_sensor_temperature",
                  "name": "Hallway"
                },
                {
                  "type": "tile",
                  "entity": "sensor.kitchen_temperature_temperature",
                  "name": "Kitchen"
                },
                {
                  "type": "tile",
                  "entity": "sensor.kitchen_temperature_humidity",
                  "name": "Kitchen Humidity"
                }
              ]
            }
          ]
        },
        {
          "title": "Weather",
          "path": "weather-detail",
          "icon": "mdi:weather-partly-cloudy",
          "type": "sections",
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
