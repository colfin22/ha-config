                    {
                      "type": "custom:button-card",
                      "entity": "image.cctv_last_alert_rear_shed",
                      "name": "Rear Shed",
                      "show_entity_picture": true,
                      "show_state": false,
                      "show_label": true,
                      "show_icon": true,
                      "label": "[[[ const s=states['sensor.cctv_last_alert_rear_shed']; if(!s||!s.attributes.review_id) return 'no alerts'; const d=new Date(s.state); const o={timeZone:'Europe/Dublin'}; const dd=d.toLocaleDateString('en-GB',{...o,day:'2-digit',month:'2-digit'}).replace('/','-'); const t=d.toLocaleTimeString('en-GB',{...o,hour:'2-digit',minute:'2-digit'}); return `${s.attributes.objects} · ${dd} ${t}`; ]]]",
                      "tap_action": {
                        "action": "javascript",
                        "javascript": "[[[ const s=states['sensor.cctv_last_alert_rear_shed']; if(!s||!s.attributes.event_id) return; const o=document.createElement('div'); o.style.cssText='position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.88);display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:zoom-out'; const i=document.createElement('img'); i.src=`/api/frigate/notifications/${s.attributes.event_id}/snapshot.jpg`; i.style.cssText='max-width:95vw;max-height:88vh;border-radius:8px;box-shadow:0 8px 40px #000'; const c=document.createElement('div'); c.textContent='Rear Shed · '+s.attributes.objects+' · '+new Date(s.state).toLocaleString('en-GB',{timeZone:'Europe/Dublin',day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}).replace('/','-').replace(',',''); c.style.cssText='color:#cfd6e4;font:14px sans-serif;margin-top:10px'; o.append(i,c); const k=(e)=>{if(e.key==='Escape'){o.remove();document.removeEventListener('keydown',k);}}; o.onclick=()=>{o.remove();document.removeEventListener('keydown',k);}; document.addEventListener('keydown',k); document.body.appendChild(o); ]]]"
                      },
                      "hold_action": {
                        "action": "none"
                      },
                      "style": {
                        "left": "83%",
                        "top": "calc(100% - 70px)",
                        "width": "30%"
                      },
                      "styles": {
                        "card": [
                          {
                            "padding": "0"
                          },
                          {
                            "border-radius": "8px"
                          },
                          {
                            "overflow": "hidden"
                          },
                          {
                            "background": "[[[ return hass.themes.darkMode ? '#121826' : '#ffffff'; ]]]"
                          },
                          {
                            "border": "[[[ const s=states['sensor.cctv_last_alert_rear_shed']; return (s&&s.attributes.review_id&&Date.now()-new Date(s.state)<3600e3) ? '2px solid #ffc94d' : (hass.themes.darkMode ? '2px solid #1d2740' : '2px solid #d3d9e4'); ]]]"
                          }
                        ],
                        "grid": [
                          {
                            "grid-template-areas": "'\"i\" \"n\" \"l\"'"
                          },
                          {
                            "grid-template-columns": "100%"
                          },
                          {
