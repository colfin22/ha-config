        {
          "title": "Doorbell",
          "path": "doorbell",
          "icon": "mdi:doorbell-video",
          "type": "sections",
          "subview": true,
          "back_path": "/smart-home/cctv",
          "max_columns": 1,
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:advanced-camera-card",
                  "cameras": [
                    {
                      "camera_entity": "camera.doorbell",
                      "live_provider": "go2rtc",
                      "go2rtc": {
                        "modes": [
                          "webrtc",
                          "mse"
                        ],
                        "stream": "Doorbell_sub",
                        "metadata_fetch_timeout_seconds": 10
                      },
                      "dimensions": {
                        "layout": {
                          "fit": "cover",
                          "position": {
                            "x": 50,
                            "y": 50
                          }
                        }
                      }
                    }
                  ],
                  "live": {
                    "auto_play": [
                      "selected",
                      "visible"
                    ],
                    "auto_unmute": [
                      "selected",
                      "visible",
                      "microphone",
                      "call"
                    ],
                    "auto_mute": [
                      "hidden"
                    ],
                    "microphone": {
                      "auto_unmute": [
                        "call"
                      ]
                    },
                    "controls": {
                      "call": {
                        "enabled": false
                      }
                    }
                  },
                  "menu": {
                    "auto_hide": [],
                    "buttons": {
                      "call": {
                        "enabled": false
                      },
                      "mute": {
                        "enabled": true,
                        "permanent": true
                      },
                      "microphone": {
                        "enabled": true,
                        "permanent": true,
                        "type": "toggle"
                      }
                    }
                  },
                  "elements": [
                    {
                      "type": "custom:advanced-camera-card-conditional",
                      "conditions": [
                        {
                          "condition": "call",
                          "call": [
                            "idle"
                          ]
                        }
                      ],
                      "elements": [
                        {
                          "type": "icon",
                          "icon": "mdi:phone",
                          "title": "Answer",
                          "style": {
                            "position": "absolute",
                            "top": "88%",
                            "width": "64px",
                            "height": "64px",
                            "border-radius": "50%",
                            "display": "flex",
                            "align-items": "center",
                            "justify-content": "center",
                            "color": "white",
                            "--mdc-icon-size": "36px",
                            "box-shadow": "0 2px 8px rgba(0,0,0,0.5)",
                            "left": "70%",
                            "background": "#2e7d32"
                          },
                          "tap_action": {
                            "action": "custom:advanced-camera-card-action",
                            "advanced_camera_card_action": "call_start"
                          }
                        }
                      ]
                    },
                    {
                      "type": "icon",
                      "icon": "mdi:phone-hangup",
                      "title": "Hang up",
                      "style": {
                        "position": "absolute",
                        "top": "88%",
                        "width": "64px",
                        "height": "64px",
                        "border-radius": "50%",
                        "display": "flex",
                        "align-items": "center",
                        "justify-content": "center",
                        "color": "white",
                        "--mdc-icon-size": "36px",
                        "box-shadow": "0 2px 8px rgba(0,0,0,0.5)",
                        "left": "30%",
                        "background": "#c62828"
                      },
                      "tap_action": [
                        {
                          "action": "custom:advanced-camera-card-action",
                          "advanced_camera_card_action": "call_end"
                        },
                        {
                          "action": "navigate",
                          "navigation_path": "/smart-home/cctv"
                        }
                      ]
                    }
                  ],
                  "grid_options": {
                    "columns": "full"
                  },
                  "dimensions": {
                    "aspect_ratio_mode": "unconstrained",
                    "height": "calc(100dvh - 120px)"
                  }
                }
              ]
            }
          ]
        },
        {
