{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.smart_home",
  "data": {
    "config": {
      "oaks_sidebar": {
        "admins": [
          "Home",
          "Household",
          "Energy",
          "Security",
          "Music Assistant",
          "---",
          "AudioMuse",
          "Night sky",
          "dashboard-map",
          "Infrastructure",
          "History",
          "AION EMS Zeus",
          "Update Manager",
          "How it Works"
        ],
        "users": [
          "Home",
          "Household",
          "Energy",
          "Security",
          "Music Assistant",
          "---",
          "AudioMuse",
          "Night sky",
          "dashboard-map",
          "How it Works"
        ]
      },
      "kiosk_mode": {
        "hide_header": true
      },
      "views": [
        {
          "title": "Home",
          "path": "home",
          "icon": "mdi:home",
          "type": "panel",
          "cards": [
            {
              "type": "vertical-stack",
              "cards": [
                {
                  "type": "custom:home-v2-card",
                  "dashboard": "house-map"
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "numeric_state",
                      "entity": "sensor.airtrail_10_0_0_221_3000_upcoming_flights",
                      "above": 0
                    }
                  ],
                  "card": {
                    "type": "custom:airtrail-card",
                    "color": "#4269D0"
                  }
                },
                {
                  "type": "custom:away-card"
                }
              ]
            }
          ]
        },
        {
          "title": "Weather",
          "path": "weather-detail",
          "icon": "mdi:weather-partly-cloudy",
          "type": "sections",
          "max_columns": 3,
          "sections": [
            {
              "type": "grid",
              "column_span": 3,
              "cards": [
                {
                  "type": "custom:weather-card",
                  "layout": "desktop",
                  "grid_options": {
                    "columns": "full"
                  },
                  "visibility": [
                    {
                      "condition": "screen",
                      "media_query": "(min-width: 768px)"
                    }
                  ]
                },
                {
                  "type": "custom:weather-card",
                  "layout": "phone",
                  "grid_options": {
                    "columns": "full"
                  },
                  "visibility": [
                    {
                      "condition": "screen",
                      "media_query": "(max-width: 767px)"
                    }
                  ]
                }
              ]
            }
          ],
          "visible": false
        },
        {
          "title": "Calendar",
          "path": "calendar-month",
          "icon": "mdi:calendar-month",
          "subview": true,
          "back_path": "/smart-home/home",
          "type": "panel",
          "cards": [
            {
              "type": "calendar",
              "initial_view": "dayGridMonth",
              "entities": [
                "calendar.home_assistant_family_planner",
                "calendar.panda_waste",
                "calendar.elphin_community_college",
                "calendar.irish_holidays",
                "calendar.clocks_moon",
                "calendar.airtrail_10_0_0_221_3000_flights"
              ]
            }
          ]
        },
        {
          "title": "Doorbell",
          "path": "doorbell",
          "icon": "mdi:doorbell-video",
          "type": "sections",
          "subview": true,
          "back_path": "/smart-home/cctv",
          "max_columns": 1,
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:advanced-camera-card",
                  "cameras": [
                    {
                      "camera_entity": "camera.doorbell",
                      "live_provider": "go2rtc",
                      "go2rtc": {
                        "modes": [
                          "webrtc",
                          "mse"
                        ],
                        "stream": "Doorbell_sub",
                        "metadata_fetch_timeout_seconds": 10
                      },
                      "dimensions": {
                        "layout": {
                          "fit": "cover",
                          "position": {
                            "x": 50,
                            "y": 50
                          }
                        }
                      }
                    }
                  ],
                  "live": {
                    "auto_play": [
                      "selected",
                      "visible"
                    ],
                    "auto_unmute": [
                      "selected",
                      "visible",
                      "microphone",
                      "call"
                    ],
                    "auto_mute": [
                      "hidden"
                    ],
                    "microphone": {
                      "auto_unmute": [
                        "call"
                      ]
                    },
                    "controls": {
                      "call": {
                        "enabled": false
                      }
                    }
                  },
                  "menu": {
                    "auto_hide": [],
                    "buttons": {
                      "call": {
                        "enabled": false
                      },
                      "mute": {
                        "enabled": true,
                        "permanent": true
                      },
                      "microphone": {
                        "enabled": true,
                        "permanent": true,
                        "type": "toggle"
                      }
                    }
                  },
                  "elements": [
                    {
                      "type": "custom:advanced-camera-card-conditional",
                      "conditions": [
                        {
                          "condition": "call",
                          "call": [
                            "idle"
                          ]
                        }
                      ],
                      "elements": [
                        {
                          "type": "icon",
                          "icon": "mdi:phone",
                          "title": "Answer",
                          "style": {
                            "position": "absolute",
                            "top": "88%",
                            "width": "64px",
                            "height": "64px",
                            "border-radius": "50%",
                            "display": "flex",
                            "align-items": "center",
                            "justify-content": "center",
                            "color": "white",
                            "--mdc-icon-size": "36px",
                            "box-shadow": "0 2px 8px rgba(0,0,0,0.5)",
                            "left": "70%",
                            "background": "#2e7d32"
                          },
                          "tap_action": {
                            "action": "custom:advanced-camera-card-action",
                            "advanced_camera_card_action": "call_start"
                          }
                        }
                      ]
                    },
                    {
                      "type": "icon",
                      "icon": "mdi:phone-hangup",
                      "title": "Hang up",
                      "style": {
                        "position": "absolute",
                        "top": "88%",
                        "width": "64px",
                        "height": "64px",
                        "border-radius": "50%",
                        "display": "flex",
                        "align-items": "center",
                        "justify-content": "center",
                        "color": "white",
                        "--mdc-icon-size": "36px",
                        "box-shadow": "0 2px 8px rgba(0,0,0,0.5)",
                        "left": "30%",
                        "background": "#c62828"
                      },
                      "tap_action": [
                        {
                          "action": "custom:advanced-camera-card-action",
                          "advanced_camera_card_action": "call_end"
                        },
                        {
                          "action": "navigate",
                          "navigation_path": "/smart-home/cctv"
                        }
                      ]
                    }
                  ],
                  "grid_options": {
                    "columns": "full"
                  },
                  "dimensions": {
                    "aspect_ratio_mode": "unconstrained",
                    "height": "calc(100dvh - 120px)"
                  }
                }
              ]
            }
          ],
          "visible": false
        }
      ]
    }
  }
}