{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.smart_home",
  "data": {
    "config": {
      "views": [
        {
          "title": "Home",
          "path": "home",
          "icon": "mdi:home",
          "type": "sections",
          "sections": [
            {
              "type": "grid",
              "column_span": 3,
              "cards": [
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "sensor.met_eireann_warning_level",
                      "state": "Orange"
                    }
                  ],
                  "card": {
                    "type": "markdown",
                    "content": "🟠 **[Orange Weather {{ states('sensor.met_eireann_warning_kind') }} — {{ states('sensor.met_eireann_warning_headline') }}](https://www.met.ie/warnings)**  \n{% set t = as_timestamp(states('sensor.met_eireann_warning_expiry'), none) %}{% if t %}Expires {{ t | timestamp_custom('%H:%M, %d %b') }}{% endif %}",
                    "card_mod": {
                      "style": "ha-card {\n  background: rgba(245, 124, 0, 0.95) !important;\n  color: #fff !important;\n  --primary-text-color: #fff;\n  --secondary-text-color: #ffe0c0;\n  border: none;\n}\n"
                    },
                    "grid_options": {
                      "columns": 12,
                      "rows": "auto"
                    }
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "sensor.met_eireann_warning_level",
                      "state": "Red"
                    }
                  ],
                  "card": {
                    "type": "markdown",
                    "content": "🔴 **[Red Weather {{ states('sensor.met_eireann_warning_kind') }} — {{ states('sensor.met_eireann_warning_headline') }}](https://www.met.ie/warnings)**  \n{% set t = as_timestamp(states('sensor.met_eireann_warning_expiry'), none) %}{% if t %}Expires {{ t | timestamp_custom('%H:%M, %d %b') }}{% endif %}",
                    "card_mod": {
                      "style": "ha-card {\n  background: rgba(198, 40, 40, 0.95) !important;\n  color: #fff !important;\n  --primary-text-color: #fff;\n  --secondary-text-color: #ffcdd2;\n  border: none;\n}\n"
                    },
                    "grid_options": {
                      "columns": 12,
                      "rows": "auto"
                    }
                  }
                },
                {
                  "type": "custom:home-card",
                  "layout": "desktop",
                  "visibility": [
                    {
                      "condition": "screen",
                      "media_query": "(min-width: 768px)"
                    }
                  ],
                  "grid_options": {
                    "columns": "full"
                  }
                },
                {
                  "type": "custom:home-card",
                  "layout": "phone",
                  "visibility": [
                    {
                      "condition": "screen",
                      "media_query": "(max-width: 767px)"
                    }
                  ],
                  "grid_options": {
                    "columns": "full"
                  },
                  "nav": {
                    "calendar": "/smart-home/calendar-month"
                  }
                },
                {
                  "type": "custom:airtrail-card",
                  "color": "#4269D0",
                  "visibility": [
                    {
                      "condition": "numeric_state",
                      "entity": "sensor.airtrail_10_0_0_221_3000_upcoming_flights",
                      "above": 0
                    }
                  ],
                  "grid_options": {
                    "columns": 18
                  }
                },
                {
                  "type": "custom:away-card",
                  "grid_options": {
                    "columns": 18
                  }
                }
              ]
            }
          ],
          "max_columns": 3
        },
        {
          "title": "CCTV",
          "path": "cctv",
          "icon": "mdi:cctv",
          "type": "sections",
          "max_columns": 3,
          "sections": [
            {
              "type": "grid",
              "column_span": 2,
              "cards": [
                {
                  "type": "heading",
                  "heading": "Live"
                },
                {
                  "type": "custom:advanced-camera-card",
                  "grid_options": {
                    "columns": "full"
                  },
                  "visibility": [
                    {
                      "condition": "screen",
                      "media_query": "(max-width: 0px)"
                    }
                  ],
                  "cameras": [
                    {
                      "camera_entity": "camera.doorbell",
                      "dimensions": {
                        "aspect_ratio": "16:9",
                        "layout": {
                          "fit": "cover"
                        }
                      }
                    },
                    {
                      "camera_entity": "camera.front_van",
                      "dimensions": {
                        "aspect_ratio": "16:9",
                        "layout": {
                          "fit": "cover"
                        }
                      }
                    },
                    {
                      "camera_entity": "camera.front_car",
                      "dimensions": {
                        "aspect_ratio": "16:9",
                        "layout": {
                          "fit": "cover"
                        }
                      }
                    },
                    {
                      "camera_entity": "camera.rear_door",
                      "dimensions": {
                        "aspect_ratio": "16:9",
                        "layout": {
                          "fit": "cover"
                        }
                      }
                    },
                    {
                      "camera_entity": "camera.rear_shed",
                      "dimensions": {
                        "aspect_ratio": "16:9",
                        "layout": {
                          "fit": "cover"
                        }
                      }
                    }
                  ],
                  "live": {
                    "display": {
                      "mode": "grid",
                      "grid_columns": 3
                    },
                    "controls": {
                      "timeline": {
                        "mode": "below",
                        "window_seconds": 21600,
                        "format": {
                          "24h": true
                        }
                      },
                      "thumbnails": {
                        "mode": "below",
                        "show_details": true
                      }
                    }
                  },
                  "menu": {
                    "buttons": {
                      "live": {
                        "permanent": true,
                        "priority": 90
                      },
                      "iris": {
                        "permanent": true
                      }
                    }
                  },
                  "view": {
                    "interaction_seconds": 60,
                    "default_reset": {
                      "after_interaction": true
                    }
                  },
                  "overrides": [
                    {
                      "conditions": [
                        {
                          "condition": "screen",
                          "media_query": "(max-width: 767px)"
                        }
                      ],
                      "set": {
                        "live.display.grid_columns": 2
                      }
                    }
                  ]
                },
                {
                  "type": "custom:cctv-card",
                  "instance_id": "frigate",
                  "grid_options": {
                    "columns": "full"
                  },
                  "visibility": [
                    {
                      "condition": "screen",
                      "media_query": "(min-width: 768px)"
                    }
                  ],
                  "nvr": {
                    "coral": "sensor.frigate_coral_inference_speed",
                    "disk": "sensor.frigate_cctv_disk_usage",
                    "uptime": "sensor.frigate_uptime",
                    "cpu": "sensor.lxc_docker_frigate_107_cpu_used",
                    "mem": "sensor.lxc_docker_frigate_107_memory_used",
                    "mem_pct": "sensor.lxc_docker_frigate_107_memory_used_percentage"
                  },
                  "cameras": [
                    {
                      "entity": "camera.doorbell",
                      "frigate": "Doorbell",
                      "name": "Doorbell",
                      "occupancy": "binary_sensor.doorbell_all_occupancy",
                      "audio": true
                    },
                    {
                      "entity": "camera.front_van",
                      "frigate": "Front_Van",
                      "name": "Front Van",
                      "occupancy": "binary_sensor.front_van_all_occupancy"
                    },
                    {
                      "entity": "camera.front_car",
                      "frigate": "Front_Car",
                      "name": "Front Car",
                      "occupancy": "binary_sensor.front_car_all_occupancy"
                    },
                    {
                      "entity": "camera.rear_door",
                      "frigate": "Rear_Door",
                      "name": "Rear Door",
                      "occupancy": "binary_sensor.rear_door_all_occupancy"
                    },
                    {
                      "entity": "camera.rear_shed",
                      "frigate": "Rear_Shed",
                      "name": "Rear Shed",
                      "occupancy": "binary_sensor.rear_shed_all_occupancy"
                    }
                  ],
                  "nav_buttons": true,
                  "frigate_url": "https://cctv.colfin22.net",
                  "publish_height": "cctv-live-height"
                },
                {
                  "type": "custom:cctv-card",
                  "instance_id": "frigate",
                  "grid_options": {
                    "columns": "full"
                  },
                  "cameras": [
                    {
                      "entity": "camera.doorbell",
                      "frigate": "Doorbell",
                      "name": "Doorbell",
                      "occupancy": "binary_sensor.doorbell_all_occupancy",
                      "audio": true
                    },
                    {
                      "entity": "camera.front_van",
                      "frigate": "Front_Van",
                      "name": "Front Van",
                      "occupancy": "binary_sensor.front_van_all_occupancy",
                      "sub": "Front_Van_sub"
                    },
                    {
                      "entity": "camera.front_car",
                      "frigate": "Front_Car",
                      "name": "Front Car",
                      "occupancy": "binary_sensor.front_car_all_occupancy",
                      "sub": "Front_Car_sub"
                    },
                    {
                      "entity": "camera.rear_door",
                      "frigate": "Rear_Door",
                      "name": "Rear Door",
                      "occupancy": "binary_sensor.rear_door_all_occupancy",
                      "sub": "Rear_Door_sub"
                    },
                    {
                      "entity": "camera.rear_shed",
                      "frigate": "Rear_Shed",
                      "name": "Rear Shed",
                      "occupancy": "binary_sensor.rear_shed_all_occupancy",
                      "sub": "Rear_Shed_sub"
                    }
                  ],
                  "columns": 2,
                  "layout": "strip",
                  "nav_buttons": true,
                  "visibility": [
                    {
                      "condition": "screen",
                      "media_query": "(max-width: 767px)"
                    }
                  ],
                  "quality_by_size": true,
                  "big_first": true,
                  "frigate_url": "https://cctv.colfin22.net"
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Where"
                },
                {
                  "type": "picture-elements",
                  "grid_options": {
                    "columns": "full"
                  },
                  "image": "/local/cctv_map.png?v=3",
                  "elements": [
                    {
                      "type": "custom:button-card",
                      "entity": "image.cctv_last_alert_front_van",
                      "name": "Front Van",
                      "show_entity_picture": true,
                      "show_state": false,
                      "show_label": true,
                      "show_icon": true,
                      "label": "[[[ const s=states['sensor.cctv_last_alert_front_van']; if(!s||!s.attributes.review_id) return 'no alerts'; const d=new Date(s.state); const o={timeZone:'Europe/Dublin'}; const dd=d.toLocaleDateString('en-GB',{...o,day:'2-digit',month:'2-digit'}).replace('/','-'); const t=d.toLocaleTimeString('en-GB',{...o,hour:'2-digit',minute:'2-digit'}); return `${s.attributes.objects} · ${dd} ${t}`; ]]]",
                      "tap_action": {
                        "action": "url",
                        "url_path": "[[[ const s=states['sensor.cctv_last_alert_front_van']; return (s&&s.attributes.event_id) ? `/api/frigate/notifications/${s.attributes.event_id}/clip.mp4` : '/smart-home/cctv'; ]]]"
                      },
                      "hold_action": {
                        "action": "more-info"
                      },
                      "style": {
                        "left": "17%",
                        "top": "9.4%",
                        "width": "30%"
                      },
                      "styles": {
                        "card": [
                          {
                            "padding": "0"
                          },
                          {
                            "border-radius": "8px"
                          },
                          {
                            "overflow": "hidden"
                          },
                          {
                            "background": "#121826"
                          },
                          {
                            "border": "[[[ const s=states['sensor.cctv_last_alert_front_van']; return (s&&s.attributes.review_id&&Date.now()-new Date(s.state)<3600e3) ? '2px solid #ffc94d' : '2px solid #1d2740'; ]]]"
                          }
                        ],
                        "grid": [
                          {
                            "grid-template-areas": "'\"i\" \"n\" \"l\"'"
                          },
                          {
                            "grid-template-columns": "100%"
                          },
                          {
                            "grid-template-rows": "auto auto auto"
                          }
                        ],
                        "img_cell": [
                          {
                            "width": "100%"
                          },
                          {
                            "height": "auto"
                          },
                          {
                            "justify-content": "stretch"
                          }
                        ],
                        "entity_picture": [
                          {
                            "width": "100%"
                          },
