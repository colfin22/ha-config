{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.smart_home",
  "data": {
    "config": {
      "oaks_sidebar": {
        "admins": [
          "Home",
          "House",
          "Energy",
          "Security",
          "Music Assistant",
          "---",
          "AudioMuse",
          "Night sky",
          "dashboard-map",
          "Infrastructure",
          "History",
          "AION EMS Zeus",
          "Update Manager",
          "How it Works"
        ],
        "users": [
          "Home",
          "House",
          "Energy",
          "Security",
          "Music Assistant",
          "---",
          "AudioMuse",
          "Night sky",
          "dashboard-map",
          "How it Works"
        ]
      },
      "kiosk_mode": {
        "hide_header": true
      },
      "views": [
        {
          "title": "Home",
          "path": "home",
          "icon": "mdi:home",
          "type": "sections",
          "sections": [
            {
              "type": "grid",
              "column_span": 3,
              "cards": [
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "sensor.met_eireann_warning_level",
                      "state": "Orange"
                    }
                  ],
                  "card": {
                    "type": "markdown",
                    "content": "🟠 **[Orange Weather {{ states('sensor.met_eireann_warning_kind') }} — {{ states('sensor.met_eireann_warning_headline') }}](https://www.met.ie/warnings)**  \n{% set t = as_timestamp(states('sensor.met_eireann_warning_expiry'), none) %}{% if t %}Expires {{ t | timestamp_custom('%H:%M, %d %b') }}{% endif %}",
                    "card_mod": {
                      "style": "ha-card {\n  background: rgba(245, 124, 0, 0.95) !important;\n  color: #fff !important;\n  --primary-text-color: #fff;\n  --secondary-text-color: #ffe0c0;\n  border: none;\n}\n"
                    },
                    "grid_options": {
                      "columns": 12,
                      "rows": "auto"
                    }
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "sensor.met_eireann_warning_level",
                      "state": "Red"
                    }
                  ],
                  "card": {
                    "type": "markdown",
                    "content": "🔴 **[Red Weather {{ states('sensor.met_eireann_warning_kind') }} — {{ states('sensor.met_eireann_warning_headline') }}](https://www.met.ie/warnings)**  \n{% set t = as_timestamp(states('sensor.met_eireann_warning_expiry'), none) %}{% if t %}Expires {{ t | timestamp_custom('%H:%M, %d %b') }}{% endif %}",
                    "card_mod": {
                      "style": "ha-card {\n  background: rgba(198, 40, 40, 0.95) !important;\n  color: #fff !important;\n  --primary-text-color: #fff;\n  --secondary-text-color: #ffcdd2;\n  border: none;\n}\n"
                    },
                    "grid_options": {
                      "columns": 12,
                      "rows": "auto"
                    }
                  }
                },
                {
                  "type": "custom:home-card",
                  "layout": "desktop",
                  "visibility": [
                    {
                      "condition": "screen",
                      "media_query": "(min-width: 768px)"
                    }
                  ],
                  "grid_options": {
                    "columns": "full"
                  },
                  "nav": {
                    "security": "/house-security/alarm",
                    "cctv": "/house-security/cctv",
                    "climate": "/house-energy/climate",
                    "energy": "/house-energy/solar",
                    "weather": "/smart-home/weather-detail",
                    "appliances": "/house-energy/appliances"
                  },
                  "rooms": [
                    {
                      "name": "Kitchen",
                      "img": "/api/image/serve/f3d6a395b6d142180c75d66206ea77fb/512x512",
                      "path": "/house-map/kitchen"
                    },
                    {
                      "name": "Sitting Room",
                      "img": "/api/image/serve/71dee4784c3ec84c9d06a85e37eb5515/512x512",
                      "path": "/house-map/sitting-room"
                    },
                    {
                      "name": "Colm",
                      "img": "/api/image/serve/afc9d2275c1e294c23313ddfe2c0235c/512x512",
                      "path": "/house-map/colm-bedroom"
                    },
                    {
                      "name": "Cian",
                      "img": "/api/image/serve/8e775435348fac8aacb27c2b9e2a5755/512x512",
                      "path": "/house-map/cian-bedroom"
                    },
                    {
                      "name": "Aoife",
                      "img": "/api/image/serve/5f84ea7ec0f15b59bcceb8cbb2149b3a/512x512",
                      "path": "/house-map/aoife-bedroom"
                    },
                    {
                      "name": "Office",
                      "img": "/api/image/serve/ae67b6d971687053d31fa9fb19b16966/512x512",
                      "path": "/house-map/office"
                    }
                  ]
                },
                {
                  "type": "custom:home-card",
                  "layout": "phone",
                  "visibility": [
                    {
                      "condition": "screen",
                      "media_query": "(max-width: 767px)"
                    }
                  ],
                  "grid_options": {
                    "columns": "full"
                  },
                  "nav": {
                    "security": "/house-security/alarm",
                    "cctv": "/house-security/cctv",
                    "climate": "/house-energy/climate",
                    "energy": "/house-energy/solar",
                    "weather": "/smart-home/weather-detail",
                    "appliances": "/house-energy/appliances",
                    "calendar": "/smart-home/calendar-month"
                  },
                  "rooms": [
                    {
                      "name": "Kitchen",
                      "img": "/api/image/serve/f3d6a395b6d142180c75d66206ea77fb/512x512",
                      "path": "/house-map/kitchen"
                    },
                    {
                      "name": "Sitting Room",
                      "img": "/api/image/serve/71dee4784c3ec84c9d06a85e37eb5515/512x512",
                      "path": "/house-map/sitting-room"
                    },
                    {
                      "name": "Colm",
                      "img": "/api/image/serve/afc9d2275c1e294c23313ddfe2c0235c/512x512",
                      "path": "/house-map/colm-bedroom"
                    },
                    {
                      "name": "Cian",
                      "img": "/api/image/serve/8e775435348fac8aacb27c2b9e2a5755/512x512",
                      "path": "/house-map/cian-bedroom"
                    },
                    {
                      "name": "Aoife",
                      "img": "/api/image/serve/5f84ea7ec0f15b59bcceb8cbb2149b3a/512x512",
                      "path": "/house-map/aoife-bedroom"
                    },
                    {
                      "name": "Office",
                      "img": "/api/image/serve/ae67b6d971687053d31fa9fb19b16966/512x512",
                      "path": "/house-map/office"
                    }
                  ]
                },
                {
                  "type": "custom:airtrail-card",
                  "color": "#4269D0",
                  "visibility": [
                    {
                      "condition": "numeric_state",
                      "entity": "sensor.airtrail_10_0_0_221_3000_upcoming_flights",
                      "above": 0
                    }
                  ],
                  "grid_options": {
                    "columns": 18
                  }
                },
                {
                  "type": "custom:away-card",
                  "grid_options": {
                    "columns": 18
                  }
                }
              ]
            }
          ],
          "max_columns": 3
        },
        {
          "title": "Weather",
          "path": "weather-detail",
          "icon": "mdi:weather-partly-cloudy",
          "type": "sections",
          "max_columns": 3,
          "sections": [
            {
              "type": "grid",
              "column_span": 3,
              "cards": [
                {
                  "type": "custom:weather-card",
                  "layout": "desktop",
                  "grid_options": {
                    "columns": "full"
                  },
                  "visibility": [
                    {
                      "condition": "screen",
                      "media_query": "(min-width: 768px)"
                    }
                  ]
                },
                {
                  "type": "custom:weather-card",
                  "layout": "phone",
                  "grid_options": {
                    "columns": "full"
                  },
                  "visibility": [
                    {
                      "condition": "screen",
                      "media_query": "(max-width: 767px)"
                    }
                  ]
                }
              ]
            }
          ],
          "visible": false
        },
        {
          "title": "Calendar",
          "path": "calendar-month",
          "icon": "mdi:calendar-month",
          "subview": true,
          "back_path": "/smart-home/home",
          "type": "panel",
          "cards": [
            {
              "type": "calendar",
              "initial_view": "dayGridMonth",
              "entities": [
                "calendar.home_assistant_family_planner",
                "calendar.panda_waste",
                "calendar.elphin_community_college",
                "calendar.irish_holidays",
                "calendar.clocks_moon",
                "calendar.airtrail_10_0_0_221_3000_flights"
              ]
            }
          ]
        },
        {
          "title": "Doorbell",
          "path": "doorbell",
          "icon": "mdi:doorbell-video",
          "type": "sections",
          "subview": true,
          "back_path": "/smart-home/cctv",
          "max_columns": 1,
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:advanced-camera-card",
                  "cameras": [
                    {
                      "camera_entity": "camera.doorbell",
                      "live_provider": "go2rtc",
                      "go2rtc": {
                        "modes": [
                          "webrtc",
                          "mse"
                        ],
                        "stream": "Doorbell_sub",
                        "metadata_fetch_timeout_seconds": 10
                      },
                      "dimensions": {
                        "layout": {
                          "fit": "cover",
                          "position": {
                            "x": 50,
                            "y": 50
                          }
                        }
                      }
                    }
                  ],
                  "live": {
                    "auto_play": [
                      "selected",
                      "visible"
                    ],
                    "auto_unmute": [
                      "selected",
                      "visible",
                      "microphone",
                      "call"
                    ],
                    "auto_mute": [
                      "hidden"
                    ],
                    "microphone": {
                      "auto_unmute": [
                        "call"
                      ]
                    },
                    "controls": {
                      "call": {
                        "enabled": false
                      }
                    }
                  },
                  "menu": {
                    "auto_hide": [],
                    "buttons": {
                      "call": {
                        "enabled": false
                      },
                      "mute": {
                        "enabled": true,
                        "permanent": true
                      },
                      "microphone": {
                        "enabled": true,
                        "permanent": true,
                        "type": "toggle"
                      }
                    }
                  },
                  "elements": [
                    {
                      "type": "custom:advanced-camera-card-conditional",
                      "conditions": [
                        {
                          "condition": "call",
                          "call": [
                            "idle"
                          ]
                        }
                      ],
                      "elements": [
                        {
                          "type": "icon",
                          "icon": "mdi:phone",
                          "title": "Answer",
                          "style": {
                            "position": "absolute",
                            "top": "88%",
                            "width": "64px",
                            "height": "64px",
                            "border-radius": "50%",
                            "display": "flex",
                            "align-items": "center",
                            "justify-content": "center",
                            "color": "white",
                            "--mdc-icon-size": "36px",
                            "box-shadow": "0 2px 8px rgba(0,0,0,0.5)",
                            "left": "70%",
                            "background": "#2e7d32"
                          },
                          "tap_action": {
                            "action": "custom:advanced-camera-card-action",
                            "advanced_camera_card_action": "call_start"
                          }
                        }
                      ]
                    },
                    {
                      "type": "icon",
                      "icon": "mdi:phone-hangup",
                      "title": "Hang up",
                      "style": {
                        "position": "absolute",
                        "top": "88%",
                        "width": "64px",
                        "height": "64px",
                        "border-radius": "50%",
                        "display": "flex",
                        "align-items": "center",
                        "justify-content": "center",
                        "color": "white",
                        "--mdc-icon-size": "36px",
                        "box-shadow": "0 2px 8px rgba(0,0,0,0.5)",
                        "left": "30%",
                        "background": "#c62828"
                      },
                      "tap_action": [
                        {
                          "action": "custom:advanced-camera-card-action",
                          "advanced_camera_card_action": "call_end"
                        },
                        {
                          "action": "navigate",
                          "navigation_path": "/smart-home/cctv"
                        }
                      ]
                    }
                  ],
                  "grid_options": {
                    "columns": "full"
                  },
                  "dimensions": {
                    "aspect_ratio_mode": "unconstrained",
                    "height": "calc(100dvh - 120px)"
                  }
                }
              ]
            }
          ],
          "visible": false
        }
      ]
    }
  }
}